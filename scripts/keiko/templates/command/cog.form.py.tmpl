"""The /${slash} slash command: it opens its form, or the panel of what is saved."""

import discord

from app.bot import DiscordBot
from app.decorators import keiko_command
from app.forms import open_feature
from app.translator import locale_str
from app.types.cogs import Cog


class ${cls}(Cog, name="${key}"):
    """The /${slash} slash command."""

    def __init__(self, bot: DiscordBot) -> None:
        self.bot = bot
        super().__init__()

    @keiko_command(
        name=locale_str("${slash}", type="name", namespace="${key}.command.slash"),
        description=locale_str("${slash}", type="description", namespace="${key}.command.slash"),
    )
    async def ${name}(self, interaction: discord.Interaction) -> None:
        """Open the form of ${key} for the member who asked."""
        await open_feature(interaction, "${key}")


async def setup(bot: DiscordBot) -> None:
    """Load the /${slash} cog."""
    await bot.add_cog(${cls}(bot))
